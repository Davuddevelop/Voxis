# Copy to .env.local and fill in. Never commit .env.local.
# None of these may start with NEXT_PUBLIC_: that prefix ships the value to the browser.

# Speech-to-text and fact extraction (Google AI Studio key).
GEMINI_API_KEY=

# Supabase. The anon key is "public" by design, so it protects nothing by itself: row security is on with no policies,
# and every table is reachable only through the app_* functions, which also demand APP_DB_SECRET.
# APP_DB_SECRET = select value from app_config where key = 'server_secret'  (never expose it to a browser).
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_DB_SECRET=

# HR login (hackathon-grade, not production auth) and the secret that signs the HR session cookie (32+ random chars).
HR_EMAIL=
HR_PASSWORD=
HR_SESSION_SECRET=
