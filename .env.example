# Copy to .env.local and fill in. Never commit .env.local.
# None of these may start with NEXT_PUBLIC_ — that prefix ships the value to the browser.

# STT + extraction (decided in M3/M4; unused keys can stay empty)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Supabase (M2). The service role key bypasses all row-level security: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HR login (M6). Hackathon-only auth, not production.
HR_EMAIL=
HR_PASSWORD=
# Random 32+ char string used to sign the HR session cookie.
HR_SESSION_SECRET=
